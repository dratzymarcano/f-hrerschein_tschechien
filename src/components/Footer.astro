---
---
<footer class="bg-gray-900 text-white pt-20 pb-10 mt-10">
    <div class="container mx-auto px-4">
        <!-- Footer Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            
            <!-- Column 1: Brand -->
            <div>
                <a href="/" class="flex items-center gap-2 mb-6">
                    <div class="w-10 h-10 bg-blue-600  flex items-center justify-center text-white">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    </div>
                    <span class="text-2xl font-black tracking-tight">Koeln<span class="text-blue-500">-Fuehrerschein</span></span>
                </a>
                <p class="text-gray-400 mb-6 leading-relaxed">
                    Ihre professionelle Führerschein-Agentur in Europa. Wir begleiten Sie transparent und vollständig durch den gesamten Erwerbsprozess.
                </p>
                <div class="flex space-x-4">
                    <!-- Social Placeholders -->
                    <a href="#" class="w-10 h-10 bg-gray-800  flex items-center justify-center hover:bg-blue-600 transition">
                        <span class="sr-only">Facebook</span>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h3 class="text-lg font-bold mb-6 text-white border-b-2 border-blue-600 inline-block pb-1">Beliebte Lizenzen</h3>
                <ul class="space-y-3">
                    <li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Deutscher Führerschein</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-in-tschechien-legal-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Tschechischer Führerschein</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-in-polen-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Polnischer Führerschein</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-in-osterreich-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Österreichischer Führerschein</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/russischer-fuehrerschein-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Russischer Führerschein</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/ukrainischer-fuehrerschein-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Ukrainischer Führerschein</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-in-ungarn-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Ungarischer Führerschein</a></li>
                    <li><a href="/mpu-gutachten-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">MPU Gutachten</a></li>
                </ul>
            </div>

            <!-- Column 3: More Links -->
             <div>
                <h3 class="text-lg font-bold mb-6 text-white border-b-2 border-blue-600 inline-block pb-1">Informationen</h3>
                <ul class="space-y-3">
                    <li><a href="/uber-uns/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Über Uns</a></li>
                    <li><a href="/blog/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Ratgeber & Blog</a></li>
                    <li><a href="/faqs/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Häufige Fragen</a></li>
                    <li><a href="/kontakt/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Kontakt</a></li>
                    <li><a href="/eu-fuhrerschein-kaufen/angelschein-kaufen/" class="text-gray-400 hover:text-blue-400 hover:pl-2 transition-all block">Angelschein</a></li>
                </ul>
            </div>

            <!-- Column 4: Contact -->
            <div>
                <h3 class="text-lg font-bold mb-6 text-white border-b-2 border-blue-600 inline-block pb-1">Kontakt</h3>
                <div class="space-y-4">
                     <div class="flex items-start">
                        <svg class="w-6 h-6 text-blue-500 mt-1 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <p class="text-gray-400 text-sm">50667 Köln<br>Deutschland</p>
                    </div>
                    <a href="mailto:contact@koeln-fuehrerschein.de" class="flex items-center group">
                         <div class="w-10 h-10  bg-blue-900/50 text-blue-500 flex items-center justify-center mr-3 group-hover:bg-blue-600 group-hover:text-white transition">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                         </div>
                         <div>
                             <p class="text-xs text-gray-400 font-bold uppercase">E-Mail</p>
                             <p class="font-bold text-white hover:text-blue-400 transition break-all text-sm">contact@koeln-fuehrerschein.de</p>
                         </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="border-t border-gray-800 pt-8 text-center">
            <p class="text-gray-500 text-sm">
                &copy; {new Date().getFullYear()} Koeln-Fuehrerschein. Alle Rechte vorbehalten. | <a href="/sitemap.xml" class="hover:text-blue-400 transition">Sitemap</a>
            </p>
        </div>
    </div>
</footer>
