---
import Layout from '../layouts/Layout.astro';

const pageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://koeln-fuehrerschein.de/mpu-gutachten-kaufen/#service",
      "name": "MPU Vorbereitung und EU-Führerschein-Beratung",
      "description": "Professionelles MPU-Coaching und Beratung zur EU-Führerschein-Alternative. Wir prüfen Ihren Fall individuell und begleiten Sie zur besten Lösung.",
      "provider": {
        "@id": "https://koeln-fuehrerschein.de/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Deutschland"
      },
      "serviceType": "MPU Gutachten"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Startseite",
          "item": "https://koeln-fuehrerschein.de"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "MPU Gutachten",
          "item": "https://koeln-fuehrerschein.de/mpu-gutachten-kaufen"
        }
      ]
    }
  ]
});
---

<Layout title="MPU Vorbereitung & Coaching | Koeln-Fuehrerschein" description="MPU Vorbereitung in Köln – professionelles Coaching, Beratung zur EU-Führerschein-Alternative und Begleitung durch den gesamten Prozess. Jetzt kostenlos anfragen." schema={pageSchema}>
	
	<main class="bg-white">
        <!-- Page Header -->
		<section class="bg-gray-900 text-white py-24 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-slate-900 z-0"></div>
            <div class="absolute inset-0 overflow-hidden opacity-20 pointer-events-none">
                 <div class="absolute -top-24 -left-24 w-96 h-96  bg-blue-500 blur-[100px]"></div>
                 <div class="absolute bottom-0 right-0 w-80 h-80  bg-green-500 blur-[100px]"></div>
            </div>
			<div class="container mx-auto px-4 text-center relative z-10">
                 <span class="inline-block py-1 px-4  bg-gray-800/50 backdrop-blur-sm border border-gray-600/30 text-gray-200 text-sm font-semibold mb-6">
                    MPU & EU-Führerschein
                </span>
				<h1 class="text-4xl lg:text-6xl font-black mb-6 tracking-tight">MPU-Coaching &amp; EU-Führerschein-Beratung</h1>
				<p class="text-xl text-gray-300 max-w-2xl mx-auto font-light leading-relaxed">
                    Ob MPU-Vorbereitung oder EU-Führerschein als legale Alternative – wir beraten Sie zu Ihrer besten Option.
                </p>
			</div>
		</section>

		<section class="py-24">
            <div class="container mx-auto px-4">
                <div class="flex flex-col lg:flex-row items-center gap-16 mb-24">
                    <div class="lg:w-1/2">
                        <div class="relative bg-gradient-to-br from-gray-100 to-white p-1  shadow-xl transform hover:rotate-1 transition duration-500">
                             <div class="bg-white  p-8 lg:p-12 overflow-hidden relative">
                                 <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50  z-0"></div>
                                 <h3 class="text-2xl font-black text-gray-900 mb-6 relative z-10">Ihre persönliche Fallberatung</h3>
                                 <div class="space-y-4 relative z-10">
                                     <p class="text-gray-600">Wir analysieren Ihre Situation kostenlos und beraten Sie zu allen rechtlichen Optionen – MPU-Vorbereitung oder EU-Führerschein-Alternative.</p>
                                     <div class="mt-8 p-4 bg-blue-50 border border-blue-100  flex items-center">
                                         <div class="w-12 h-12 bg-blue-100  flex items-center justify-center text-blue-600 font-bold text-xl mr-4">✓</div>
                                         <div>
                                             <p class="text-xs text-gray-500 uppercase font-bold">Unser Ansatz</p>
                                             <p class="text-xl font-bold text-blue-700">INDIVIDUELL</p>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                        </div>
                    </div>
                    <div class="lg:w-1/2">
                        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6 leading-tight">
                            Zurück zur Mobilität <span class="text-blue-600">mit professioneller Beratung</span>
                        </h2>
                        <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                            Die MPU (Medizinisch-Psychologische Untersuchung) bereitet vielen Autofahrern große Sorgen. Unser Team berät Sie zu allen Ihren Optionen: von der professionellen MPU-Vorbereitung bis hin zur EU-Führerschein-Alternative für Fälle, in denen die Sperrfrist abgelaufen ist.
                        </p>
                         <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                            Mit unserer Erfahrung in der EU-Führerscheinvermittlung kennen wir die rechtlichen Möglichkeiten genau. Wir prüfen Ihren Fall individuell und entwickeln mit Ihnen gemeinsam die beste Strategie für Ihre Mobilität.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a href="/kontakt/" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8  shadow-lg transition duration-300 transform hover:-translate-y-1">
                                Anfrage Senden
                            </a>
                        </div>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
                    <div class="bg-white p-8  shadow-lg border border-gray-100 hover:-translate-y-2 transition duration-300">
                        <div class="w-16 h-16 bg-blue-50  flex items-center justify-center text-3xl mb-6">🔍</div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Individuelle Fallprüfung</h3>
                        <p class="text-gray-600">Jeder Fall ist anders. Wir analysieren Ihre Situation und beraten Sie zu den besten rechtlichen Möglichkeiten.</p>
                    </div>
                    <div class="bg-white p-8  shadow-lg border border-gray-100 hover:-translate-y-2 transition duration-300">
                        <div class="w-16 h-16 bg-blue-50  flex items-center justify-center text-3xl mb-6">⚖️</div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">EU-Führerschein-Alternative</h3>
                        <p class="text-gray-600">Nach Ablauf Ihrer Sperrfrist kann ein EU-Führerschein aus einem anderen Mitgliedstaat eine legale Option darstellen.</p>
                    </div>
                    <div class="bg-white p-8  shadow-lg border border-gray-100 hover:-translate-y-2 transition duration-300">
                        <div class="w-16 h-16 bg-blue-50  flex items-center justify-center text-3xl mb-6">📋</div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Vollständige Begleitung</h3>
                        <p class="text-gray-600">Von der ersten Beratung bis zur Aushändigung Ihres Führerscheins – wir sind immer für Sie erreichbar.</p>
                    </div>
                </div>

                <div class="bg-blue-900  overflow-hidden shadow-2xl relative">
                    <div class="absolute inset-0 bg-gradient-to-r from-blue-900 to-indigo-900 z-0"></div>
                     <div class="absolute inset-0 overflow-hidden opacity-30 pointer-events-none">
                         <div class="absolute top-0 right-0 w-80 h-80  bg-blue-500 blur-[80px]"></div>
                    </div>
                    <div class="relative z-10 p-12 lg:p-16 text-center text-white">
                        <h3 class="text-3xl lg:text-4xl font-bold mb-6">Lassen Sie sich kostenlos beraten</h3>
                        <p class="text-xl text-blue-200 mb-4 max-w-2xl mx-auto">
                           Für eine kostenlose Erstberatung finden wir gemeinsam die beste Lösung für Ihre Situation.
                        </p>
                         <p class="text-lg text-blue-200 mb-10 max-w-2xl mx-auto">
                           Inkl. Bewertung Ihrer MPU-Optionen und EU-Alternativen. Wir erstellen Ihnen ein transparentes, individuelles Angebot.
                        </p>
                        <a href="/kontakt/" class="inline-block bg-white text-blue-900 font-bold py-4 px-10  hover:bg-gray-100 transition duration-300 shadow-lg transform hover:-translate-y-1">
                            JETZT KOSTENLOS BERATEN
                        </a>
                    </div>
                </div>

                <!-- Related Articles -->
                <div class="mt-24 bg-gray-50 p-12 lg:p-16">
                    <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">Mehr erfahren im Blog</h3>
                    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <a href="/blog/mpu-umgehen-legal/" class="block p-6 bg-white hover:shadow-lg transition border border-gray-200">
                            <span class="text-blue-600 font-bold block mb-2">→ MPU-Alternative: EU-Führerschein</span>
                            <p class="text-sm text-gray-600">Rechtslage und EuGH-Urteile.</p>
                        </a>
                        <a href="/blog/fuehrerschein-zurueck-ohne-mpu/" class="block p-6 bg-white hover:shadow-lg transition border border-gray-200">
                            <span class="text-blue-600 font-bold block mb-2">→ Führerschein zurück</span>
                            <p class="text-sm text-gray-600">Ohne MPU wieder mobil.</p>
                        </a>
                        <a href="/eu-fuhrerschein-kaufen/fuhrerschein-in-polen-kaufen/" class="block p-6 bg-white hover:shadow-lg transition border border-gray-200">
                            <span class="text-blue-600 font-bold block mb-2">→ Polnischer Führerschein</span>
                            <p class="text-sm text-gray-600">Alternative zur MPU.</p>
                        </a>
                        <a href="/blog/eu-fuehrerschein-rechtslage-2025/" class="block p-6 bg-white hover:shadow-lg transition border border-gray-200">
                            <span class="text-blue-600 font-bold block mb-2">→ EU-Rechtslage 2026</span>
                            <p class="text-sm text-gray-600">Aktuelle Gesetze.</p>
                        </a>
                    </div>
                </div>

            </div>
		</section>

	</main>
</Layout>
