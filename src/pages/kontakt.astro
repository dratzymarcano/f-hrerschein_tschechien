---
import Layout from '../layouts/Layout.astro';

const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://koeln-fuehrerschein.de/kontakt/#contactpage",
      "name": "Kontakt - Koeln-Fuehrerschein",
      "description": "Kontaktieren Sie Koeln-Fuehrerschein für eine kostenlose Erstberatung zum EU-Führerscheinerwerb. Per E-Mail oder Kontaktformular.",
      "url": "https://koeln-fuehrerschein.de/kontakt",
      "mainEntity": {
        "@id": "https://koeln-fuehrerschein.de/#organization"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Startseite",
          "item": "https://koeln-fuehrerschein.de"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Kontakt",
          "item": "https://koeln-fuehrerschein.de/kontakt"
        }
      ]
    }
  ]
});
---

<Layout title="Kontakt | Kostenlose Führerschein-Beratung | Koeln-Fuehrerschein" description="Kontaktieren Sie Koeln-Fuehrerschein für eine kostenlose Erstberatung. Wir begleiten Sie durch den gesamten EU-Führerscheinprozess." schema={contactSchema}>
	
	<main class="bg-gray-50">
		<!-- Hero Section -->
		<section class="bg-blue-900 text-white py-24 relative overflow-hidden">
            <div class="absolute inset-0 bg-blue-900 z-0"></div>
            <img src="/images/background-hero.webp" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-45 z-0 mix-blend-overlay" />
			<div class="container mx-auto px-4 text-center relative z-10">
				<h1 class="text-4xl lg:text-6xl font-bold mb-6 tracking-tight">Kontaktieren Sie Uns</h1>
				<p class="text-xl text-blue-100 max-w-2xl mx-auto leading-relaxed">
                    Wir stehen Ihnen gerne zur Verfügung. Schreiben Sie uns eine Nachricht oder senden Sie uns eine E-Mail – wir antworten in der Regel innerhalb von 24 Stunden.
                </p>
			</div>
		</section>

		<!-- Contact Content -->
		<section class="py-24 -mt-20 relative z-20">
			<div class="container mx-auto px-4">
				<div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
				
                    <!-- Contact Info Cards -->
                    <div class="space-y-6">
                         <!-- Email Card -->
                        <div class="bg-white p-8  shadow-xl hover:-translate-y-1 transition duration-300 border border-gray-100 overflow-hidden relative">
                             <div class="absolute right-0 top-0 w-32 h-32 bg-blue-50  -mr-8 -mt-8 z-0"></div>
                             <div class="relative z-10 flex items-start">
                                <div class="w-14 h-14 bg-blue-100 text-blue-600  flex items-center justify-center flex-shrink-0 mr-6 shadow-sm">
                                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-gray-900 mb-1">E-Mail</h3>
                                    <p class="text-gray-500 mb-4 text-sm">Für allgemeine Anfragen</p>
                                    <p class="text-lg font-bold text-gray-800 mb-4 break-all">contact@koeln-fuehrerschein.de</p>
                                    <a href="mailto:contact@koeln-fuehrerschein.de" class="inline-flex items-center text-blue-600 font-bold hover:underline">
                                        E-Mail Senden
                                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                    </a>
                                </div>
                             </div>
                        </div>

                        <!-- Location Card -->
                         <div class="bg-white p-8  shadow-xl hover:-translate-y-1 transition duration-300 border border-gray-100 overflow-hidden relative">
                             <div class="absolute right-0 top-0 w-32 h-32 bg-indigo-50  -mr-8 -mt-8 z-0"></div>
                             <div class="relative z-10 flex items-start">
                                <div class="w-14 h-14 bg-indigo-100 text-indigo-600  flex items-center justify-center flex-shrink-0 mr-6 shadow-sm">
                                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-gray-900 mb-1">Standort</h3>
                                    <p class="text-gray-500 mb-4 text-sm">Unser Büro in Köln</p>
                                    <p class="text-lg font-bold text-gray-800">50667 Köln</p>
                                    <p class="text-sm text-gray-600">Deutschland</p>
                                </div>
                             </div>
                        </div>
                    </div>

                    <!-- Contact Form -->
                    <div class="bg-white p-8 lg:p-10  shadow-2xl border border-gray-100">
                        <h2 class="text-2xl font-bold text-gray-900 mb-6">Schreiben Sie uns</h2>
                        <div id="form-success" class="hidden bg-green-50 border border-green-200 text-green-800 p-6 text-center mb-6">
                            <p class="font-bold text-lg mb-1">Nachricht gesendet!</p>
                            <p class="text-sm">Wir melden uns in der Regel innerhalb von 24 Stunden bei Ihnen.</p>
                        </div>
                        <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-800 p-4 text-sm mb-6"></div>
                        <form id="contact-form" class="space-y-6" novalidate>
                            <div>
                                <label class="block text-gray-700 text-sm font-bold mb-2 ml-1" for="name">Ihr Name *</label>
                                <input class="w-full px-5 py-4  bg-gray-50 border border-gray-200 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition outline-none" id="name" name="name" type="text" placeholder="Max Mustermann" required>
                            </div>
                             <div>
                                <label class="block text-gray-700 text-sm font-bold mb-2 ml-1" for="email">E-Mail Adresse *</label>
                                <input class="w-full px-5 py-4  bg-gray-50 border border-gray-200 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition outline-none" id="email" name="email" type="email" placeholder="max@beispiel.de" required>
                            </div>
                             <div>
                                <label class="block text-gray-700 text-sm font-bold mb-2 ml-1" for="service">Gewünschter Service</label>
                                <div class="relative">
                                    <select class="w-full px-5 py-4 appearance-none bg-gray-50 border border-gray-200 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition outline-none cursor-pointer text-gray-700" id="service" name="service">
                                        <option value="" disabled selected>Bitte wählen...</option>
                                        <option value="Deutscher Führerschein">Deutscher Führerschein</option>
                                        <option value="Österreichischer Führerschein">Österreichischer Führerschein</option>
                                        <option value="Schweizer Führerschein">Schweizer Führerschein</option>
                                        <option value="Polnischer Führerschein">Polnischer Führerschein</option>
                                        <option value="Tschechischer Führerschein">Tschechischer Führerschein</option>
                                        <option value="Ungarischer Führerschein">Ungarischer Führerschein</option>
                                        <option value="Russischer Führerschein">Russischer Führerschein</option>
                                        <option value="Ukrainischer Führerschein">Ukrainischer Führerschein</option>
                                        <option value="MPU-Coaching & Beratung">MPU-Coaching & Beratung</option>
                                        <option value="Angelschein">Angelschein</option>
                                        <option value="Bootsführerschein">Bootsführerschein</option>
                                        <option value="Sonstige Anfrage">Sonstige Anfrage</option>
                                    </select>
                                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                                        <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                                    </div>
                                </div>
                            </div>
                             <div>
                                <label class="block text-gray-700 text-sm font-bold mb-2 ml-1" for="message">Ihre Nachricht *</label>
                                <textarea class="w-full px-5 py-4  bg-gray-50 border border-gray-200 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition outline-none" id="message" name="message" rows="5" placeholder="Wie können wir Ihnen helfen?" required></textarea>
                            </div>
                            <button id="submit-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-6  shadow-lg hover:shadow-xl transition duration-300 transform hover:-translate-y-1 disabled:opacity-60 disabled:cursor-not-allowed" type="submit">
                                NACHRICHT SENDEN
                            </button>
                        </form>
                    </div>
				</div>
			</div>
		</section>

        <!-- CTA Strip -->
         <section class="py-16 bg-white">
            <div class="container mx-auto px-4 text-center">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Häufig gestellte Fragen</h3>
                <p class="text-gray-600 mb-8 max-w-xl mx-auto">Viele Fragen werden bereits in unserem FAQ-Bereich beantwortet.</p>
                <a href="/faqs/" class="inline-block border-2 border-blue-600 text-blue-600 font-bold py-3 px-8  hover:bg-blue-50 transition duration-300">
                    Zu den FAQs
                </a>
            </div>
         </section>

	</main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successBox = document.getElementById('form-success') as HTMLElement;
  const errorBox = document.getElementById('form-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const service = (document.getElementById('service') as HTMLSelectElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      errorBox.textContent = 'Bitte füllen Sie alle Pflichtfelder aus.';
      errorBox.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Wird gesendet…';

    try {
      const res = await fetch('/api/contact/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, service, message }),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      } else {
        const data = await res.json();
        errorBox.textContent = data.error || 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.';
        errorBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'NACHRICHT SENDEN';
      }
    } catch {
      errorBox.textContent = 'Verbindungsfehler. Bitte versuchen Sie es erneut.';
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'NACHRICHT SENDEN';
    }
  });
</script>
