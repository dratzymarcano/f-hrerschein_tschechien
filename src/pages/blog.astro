---

<Layout title="Blog & Ratgeber | Koeln-Fuehrerschein" description="Aktuelle Ratgeber und Expertenwissen rund um den EU-Führerschein: EuGH-Urteile, Rechtslage, Wohnsitzprinzip und unser Begleitservice für Ihren legalen Erwerb.">
	
	<main class="bg-gray-50 min-h-screen">
		<!-- Hero Section -->
		<section class="bg-blue-900 text-white py-24 relative overflow-hidden">
             <div class="absolute inset-0 bg-gradient-to-br from-blue-900 via-indigo-900 to-purple-900 z-0"></div>
             <img src="/images/background-hero.webp" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-45 z-0 mix-blend-overlay" />
              <!-- Decorative blobs -->
            <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-400 opacity-10 blur-3xl transform -translate-x-1/2 translate-y-1/2"></div>
            
			<div class="container mx-auto px-4 text-center relative z-10">
				<h1 class="text-4xl lg:text-5xl font-black mb-6 tracking-tight">Magazin & Ratgeber</h1>
				<p class="text-xl text-blue-100 max-w-2xl mx-auto font-light">
                    Expertenwissen, aktuelle Urteile und Tipps rund um Ihren Weg zurück zum Führerschein.
                </p>
			</div>
		</section>

		<!-- Content -->
		<section class="py-24">
			<div class="container mx-auto px-4">
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    
                    {posts.map((post) => (
                        <article class="bg-white shadow-lg border border-gray-100 overflow-hidden hover:-translate-y-2 transition-all duration-300 flex flex-col h-full group">
                            <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center relative overflow-hidden">
                                <span class="text-6xl transform group-hover:scale-110 transition duration-500">{post.image}</span>
                                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur text-xs font-bold px-3 py-1 text-blue-900 uppercase tracking-wide">
                                    {post.category}
                                </div>
                            </div>
                            <div class="p-8 flex flex-col flex-grow">
                                <div class="text-xs text-gray-400 font-bold mb-3">{post.date}</div>
                                <h2 class="text-xl font-bold text-gray-900 mb-4 leading-tight group-hover:text-blue-600 transition-colors">
                                    <a href={post.link}>
                                        {post.title}
                                    </a>
                                </h2>
                                <p class="text-gray-600 text-sm mb-6 flex-grow leading-relaxed">
                                    {post.excerpt}
                                </p>
                                <a href={post.link} class="inline-flex items-center font-bold text-blue-600 hover:text-blue-800 transition">
                                    Artikel lesen
                                    <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                </a>
                            </div>
                        </article>
                    ))}

                </div>
			</div>
		</section>
        
        <!-- Newsletter / Contact Teaser -->
         <section class="py-16 bg-white">
            <div class="container mx-auto px-4 max-w-4xl text-center">
                <h2 class="text-3xl font-bold text-gray-900 mb-6">Haben Sie spezifische Fragen?</h2>
                <p class="text-gray-600 mb-8">Unser Expertenteam steht Ihnen für eine individuelle Analyse Ihrer Situation zur Verfügung.</p>
                <a href="/kontakt/" class="bg-gray-900 text-white font-bold py-3 px-8 hover:bg-gray-800 transition shadow-lg">Kontakt aufnehmen</a>
            </div>
        </section>

	</main>
</Layout>
