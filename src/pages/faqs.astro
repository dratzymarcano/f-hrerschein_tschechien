---
import Layout from '../layouts/Layout.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie funktioniert Ihr Service genau?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir sind eine Vermittlungsagentur, die Sie durch den gesamten Prozess des EU-Führerscheinerwerbs begleitet. Wir koordinieren alle Schritte: Beratung zu Ihren Optionen, Zusammenarbeit mit unseren Partnerfahrschulen im EU-Ausland, Übernahme aller Behördengänge und regelmäßige Status-Updates bis zur Aushändigung Ihres Führerscheins."
      }
    },
    {
      "@type": "Question",
      "name": "Sind Ihre Dienstleistungen legal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, vollständig. Wir nutzen das EU-Recht auf gegenseitige Anerkennung von Fahrerlaubnissen (3. EU-Führerscheinrichtlinie). Alle Führerscheine werden von offiziellen Behörden in EU-Mitgliedstaaten ausgestellt und sind in ganz Europa gültig. Der EuGH hat mehrfach bestätigt, dass Deutschland EU-Führerscheine aus anderen Mitgliedstaaten anerkennen muss."
      }
    },
    {
      "@type": "Question",
      "name": "Was genau übernehmen Sie für mich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir übernehmen: die Beratung zu Ihren rechtlichen Möglichkeiten, die Koordination mit unseren Partnerfahrschulen, alle erforderlichen Anmeldeformalitäten, die Wohnsitzanmeldung gemäß Wohnsitzprinzip, Behördengänge und Dokumentation sowie regelmäßige Updates zum Fortschritt Ihres Antrags."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert der Prozess?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Bearbeitungszeit variiert je nach gewähltem EU-Land und Führerscheinklasse. In der Regel begleiten wir Sie 3 bis 6 Wochen durch den Prozess. Wir halten Sie per E-Mail über jeden Schritt informiert."
      }
    },
    {
      "@type": "Question",
      "name": "Ist der EU-Führerschein auch nach einer MPU-Anordnung in Deutschland gültig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Das kommt auf Ihren individuellen Fall an. Wenn Ihre eventuelle Sperrfrist in Deutschland abgelaufen ist und das Wohnsitzprinzip (185-Tage-Regelung) korrekt eingehalten wird, muss Deutschland den EU-Führerschein gemäß EuGH-Rechtsprechung anerkennen. Wir beraten Sie kostenlos zu Ihrer konkreten Situation."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet Ihr Service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unsere Preise variieren je nach Führerscheinklasse und Land. Wir erstellen Ihnen nach einer kostenlosen Erstberatung ein individuelles Angebot. Wir arbeiten ohne versteckte Kosten und informieren Sie transparent über alle anfallenden Gebühren."
      }
    }
  ]
});
---

<Layout title="FAQs | Häufige Fragen zum EU-Führerscheinerwerb | Koeln-Fuehrerschein" description="Häufig gestellte Fragen zu unserem Führerschein-Beratungsservice in Köln. Erfahren Sie, wie wir Sie durch den EU-Führerscheinprozess begleiten." schema={faqSchema}>

	<main class="bg-gray-50">
		<!-- Hero Section -->
		<section class="bg-indigo-900 text-white py-24 relative overflow-hidden">
            <div class="absolute inset-0 bg-indigo-900 z-0"></div>
            <img src="/images/background-hero.webp" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-45 z-0 mix-blend-overlay" />
			<div class="container mx-auto px-4 text-center relative z-10">
                 <span class="inline-block py-1 px-4 bg-indigo-800 text-indigo-200 text-sm font-semibold mb-6">
                    Hilfecenter
                </span>
				<h1 class="text-4xl lg:text-6xl font-bold mb-6 tracking-tight">Häufig Gestellte Fragen</h1>
				<p class="text-xl text-indigo-100 max-w-2xl mx-auto leading-relaxed">
                    Hier finden Sie Antworten auf die wichtigsten Fragen zu unserem Beratungsservice und dem EU-Führerscheinerwerb.
                </p>
			</div>
		</section>

		<!-- FAQs Section -->
		<section class="py-24">
			<div class="container mx-auto px-4 max-w-3xl">

                <div class="space-y-4">
                    <!-- Q1 -->
                    <div class="bg-white  shadow-md overflow-hidden border border-gray-100">
                        <details class="group">
                            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 bg-white hover:bg-gray-50 transition-colors">
                                <span class="text-lg font-bold text-gray-900">Wie funktioniert Ihr Service genau?</span>
                                <span class="transition group-open:rotate-180">
                                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                                </span>
                            </summary>
                            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed">
                                <p>Wir sind eine Vermittlungsagentur, die Sie durch den gesamten Prozess des EU-Führerscheinerwerbs begleitet. Wir koordinieren alle Schritte: Beratung zu Ihren Optionen, Zusammenarbeit mit unseren Partnerfahrschulen im EU-Ausland, Übernahme aller Behördengänge und regelmäßige Status-Updates bis zur Aushändigung Ihres Führerscheins.</p>
                            </div>
                        </details>
                    </div>

                     <!-- Q2 -->
                    <div class="bg-white  shadow-md overflow-hidden border border-gray-100">
                        <details class="group">
                            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 bg-white hover:bg-gray-50 transition-colors">
                                <span class="text-lg font-bold text-gray-900">Sind Ihre Dienstleistungen legal?</span>
                                <span class="transition group-open:rotate-180">
                                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                                </span>
                            </summary>
                            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed">
                                <p>Ja, vollständig. Wir nutzen das EU-Recht auf gegenseitige Anerkennung von Fahrerlaubnissen (3. EU-Führerscheinrichtlinie). Alle Führerscheine werden von offiziellen Behörden in EU-Mitgliedstaaten ausgestellt und sind in ganz Europa gültig. Der EuGH hat mehrfach bestätigt, dass Deutschland EU-Führerscheine aus anderen Mitgliedstaaten anerkennen muss.</p>
                            </div>
                        </details>
                    </div>

                     <!-- Q3 -->
                    <div class="bg-white  shadow-md overflow-hidden border border-gray-100">
                        <details class="group">
                            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 bg-white hover:bg-gray-50 transition-colors">
                                <span class="text-lg font-bold text-gray-900">Was genau übernehmen Sie für mich?</span>
                                <span class="transition group-open:rotate-180">
                                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                                </span>
                            </summary>
                            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed">
                                <p>Wir übernehmen: die Beratung zu Ihren rechtlichen Möglichkeiten, die Koordination mit unseren Partnerfahrschulen, alle erforderlichen Anmeldeformalitäten, die Wohnsitzanmeldung gemäß Wohnsitzprinzip, Behördengänge und Dokumentation sowie regelmäßige Updates zum Fortschritt Ihres Antrags.</p>
                            </div>
                        </details>
                    </div>

                     <!-- Q4 -->
                    <div class="bg-white  shadow-md overflow-hidden border border-gray-100">
                        <details class="group">
                            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 bg-white hover:bg-gray-50 transition-colors">
                                <span class="text-lg font-bold text-gray-900">Wie lange dauert der Prozess?</span>
                                <span class="transition group-open:rotate-180">
                                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                                </span>
                            </summary>
                            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed">
                                <p>Die Bearbeitungszeit variiert je nach gewähltem EU-Land und Führerscheinklasse. In der Regel begleiten wir Sie <strong>3 bis 6 Wochen</strong> durch den Prozess. Wir halten Sie per E-Mail über jeden Schritt informiert.</p>
                            </div>
                        </details>
                    </div>

                     <!-- Q5 -->
                    <div class="bg-white  shadow-md overflow-hidden border border-gray-100">
                        <details class="group">
                            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 bg-white hover:bg-gray-50 transition-colors">
                                <span class="text-lg font-bold text-gray-900">Ist der EU-Führerschein auch nach einer MPU-Anordnung in Deutschland gültig?</span>
                                <span class="transition group-open:rotate-180">
                                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                                </span>
                            </summary>
                            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed">
                                <p>Das kommt auf Ihren individuellen Fall an. Wenn Ihre eventuelle Sperrfrist in Deutschland abgelaufen ist und das Wohnsitzprinzip (185-Tage-Regelung) korrekt eingehalten wird, muss Deutschland den EU-Führerschein gemäß EuGH-Rechtsprechung anerkennen. Wir beraten Sie kostenlos zu Ihrer konkreten Situation.</p>
                            </div>
                        </details>
                    </div>

                     <!-- Q6 -->
                    <div class="bg-white  shadow-md overflow-hidden border border-gray-100">
                        <details class="group">
                            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 bg-white hover:bg-gray-50 transition-colors">
                                <span class="text-lg font-bold text-gray-900">Was kostet Ihr Service?</span>
                                <span class="transition group-open:rotate-180">
                                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                                </span>
                            </summary>
                            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed">
                                <p>Unsere Preise variieren je nach Führerscheinklasse und Land. Wir erstellen Ihnen nach einer kostenlosen Erstberatung ein individuelles Angebot. Wir arbeiten ohne versteckte Kosten und informieren Sie transparent über alle anfallenden Gebühren.</p>
                            </div>
                        </details>
                    </div>

                </div>

                <div class="mt-16 bg-blue-50  p-8 text-center border border-blue-100">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">Noch Fragen offen?</h3>
                    <p class="text-gray-600 mb-6">Unser Team hilft Ihnen gerne weiter – kostenlos und unverbindlich.</p>
                    <a href="/kontakt/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8  transition duration-300 shadow-md">
                        Kostenlos Anfragen
                    </a>
                </div>

			</div>
		</section>

	</main>
</Layout>
