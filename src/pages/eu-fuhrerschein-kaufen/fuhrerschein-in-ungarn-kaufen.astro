                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="/kontakt/" class="inline-block bg-white text-green-600 font-bold py-4 px-10  hover:bg-gray-100 transition duration-300 shadow-lg transform hover:-translate-y-1">
