                            <div class="bg-white p-8  shadow-lg border border-gray-100 text-center hover:-translate-y-2 transition duration-300">
                                <div class="w-16 h-16 bg-green-50  flex items-center justify-center text-3xl mx-auto mb-6">🚗</div>
                                <h4 class="font-bold text-xl mb-3 text-gray-900">Klasse B (PKW)</h4>
