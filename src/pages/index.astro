          "position": 1,
          "name": "Startseite",
          "item": "https://koeln-fuehrerschein.de"
        }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Führerschein Beratungs-Services",
      "description": "Unsere EU-Führerschein-Beratungs- und Vermittlungsservices in Köln",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Deutscher Führerschein",
          "url": "https://koeln-fuehrerschein.de/eu-fuhrerschein-kaufen/fuhrerschein-kaufen"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Polnischer Führerschein",
          "url": "https://koeln-fuehrerschein.de/eu-fuhrerschein-kaufen/fuhrerschein-in-polen-kaufen"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tschechischer Führerschein",
          "url": "https://koeln-fuehrerschein.de/eu-fuhrerschein-kaufen/fuhrerschein-in-tschechien-legal-kaufen"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Ungarischer Führerschein",
          "url": "https://koeln-fuehrerschein.de/eu-fuhrerschein-kaufen/fuhrerschein-in-ungarn-kaufen"
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "MPU Coaching & Beratung",
          "url": "https://koeln-fuehrerschein.de/mpu-gutachten-kaufen"
        }
      ]
    }
  ]
});
---

<Layout title="EU-Führerschein Legal Erwerben – Professionelle Begleitung | Koeln-Fuehrerschein" description="Führerschein legal erwerben in Europa ✓ Wir übernehmen alle Formalitäten ✓ Regelmäßige Status-Updates ✓ Partnerfahrschulen in 6 EU-Ländern ✓ Kostenlose Erstberatung" schema={homeSchema}>
	
	<main class="overflow-x-hidden">
		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-blue-900 via-gray-900 to-black text-white min-h-[85vh] flex items-center pt-24 pb-20 overflow-hidden">
			<!-- Overlay Image -->
			<div class="absolute inset-0 z-0">
                <img src="/images/background-hero.webp" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-45" />
				<!-- You can place a background image here if consistent with reference -->
                <div class="absolute inset-0 bg-blue-900/60 mix-blend-multiply"></div>
			</div>

			<div class="container mx-auto px-4 relative z-10 text-center">
				<h1 class="text-4xl md:text-5xl lg:text-7xl font-bold mb-6 leading-tight uppercase">
					Ihr Führerschein – Professionell Begleitet
				</h1>
				<p class="text-xl md:text-2xl text-gray-200 mb-10 font-light max-w-4xl mx-auto">
					Wir übernehmen alle Behördengänge und Formalitäten, damit Sie Ihren EU-Führerschein legal und stressfrei erwerben können.
				</p>
				<div class="flex flex-col sm:flex-row justify-center gap-6">
					<a href="/kontakt/" class="bg-blue-600 hover:bg-blue-700 text-white text-lg font-bold py-4 px-12 shadow-lg transition duration-300 uppercase tracking-widest">
						Kostenlos beraten lassen
					</a>
				</div>
			</div>
		</section>

		<!-- Info Bar -->
		<div class="bg-blue-600 text-white py-8 relative z-20 -mt-10 mx-4 md:mx-auto max-w-7xl shadow-2xl">
			<div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-blue-500">
				<div class="px-4">
					<div class="text-4xl font-bold mb-2">100%</div>
					<div class="text-blue-100 text-sm uppercase tracking-wide">Kundenzufriedenheit</div>
				</div>
				<div class="px-4">
					<div class="text-4xl font-bold mb-2">2000+</div>
					<div class="text-blue-100 text-sm uppercase tracking-wide">Begleitete Kunden</div>
				</div>
				<div class="px-4">
					<div class="text-4xl font-bold mb-2">24h</div>
					<div class="text-blue-100 text-sm uppercase tracking-wide">Support Erreichbar</div>
				</div>
				<div class="px-4">
					<div class="text-4xl font-bold mb-2">EU</div>
					<div class="text-blue-100 text-sm uppercase tracking-wide">Weit Gültig</div>
				</div>
			</div>
		</div>

		<!-- Main Content Section -->
		<section class="py-20 bg-white">
			<div class="container mx-auto px-4">
				<div class="flex flex-col lg:flex-row gap-16 items-start">
					<!-- Sidebar Menu -->
					<div class="lg:w-1/4 w-full sticky top-36">
						<div class="bg-gray-50 border border-gray-100  shadow-sm p-0">
							<div class="bg-gray-900 text-white font-bold p-4 uppercase text-sm tracking-widest text-center">Führerscheine</div>
							<ul class="flex flex-col divide-y divide-gray-200">
								<li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-kaufen/" class="block px-6 py-4 hover:bg-white hover:text-blue-600 transition font-medium text-gray-700 flex justify-between items-center group">
                                    Deutscher Führerschein <span class="text-gray-300 group-hover:text-blue-600">→</span>
                                </a></li>
								<li><a href="/eu-fuhrerschein-kaufen/fuhrerschein-in-osterreich-kaufen/" class="block px-6 py-4 hover:bg-white hover:text-blue-600 transition font-medium text-gray-700 flex justify-between items-center group">
