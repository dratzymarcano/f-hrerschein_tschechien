---
import Layout from '../layouts/Layout.astro';

const homeSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://koeln-fuehrerschein.de/#webpage",
      "url": "https://koeln-fuehrerschein.de",
      "name": "EU-Führerschein Legal Erwerben – Professionelle Begleitung | Koeln-Fuehrerschein",
