---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
    description?: string;
    schema?: string;
}

const { title, description = "Ihr Partner für den EU-Führerscheinerwerb in Europa – professionelle Beratung, vollständige Dokumentenbegleitung und lückenlose Status-Updates bis zur Aushändigung.", schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
        <meta name="keywords" content="eu führerschein legal erwerben, führerschein beratung köln, führerschein agentur eu, führerschein vermittlung, eu führerschein tschechien, eu führerschein polen, eu führerschein ungarn, eu führerschein österreich, mpu beratung köln, führerschein begleitung europa, führerschein klasse b eu, führerschein anerkennung deutschland, koeln fuehrerschein, führerschein legal erwerben, führerschein beratungsagentur" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="author" content="Koeln-Fuehrerschein" />
        <meta name="geo.region" content="DE-NW" />
        <meta name="geo.placename" content="Köln" />
        <meta name="geo.position" content="50.937531;6.960279" />
        <meta name="ICBM" content="50.937531, 6.960279" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://koeln-fuehrerschein.de/images/og-image.webp" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Koeln-Fuehrerschein - Ihr Partner für den EU-Führerscheinerwerb in Europa" />
        <meta property="og:site_name" content="Koeln-Fuehrerschein" />
        <meta property="og:locale" content="de_DE" />
        
        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://koeln-fuehrerschein.de/images/og-image.webp" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		<title>{title}</title>

        {schema && <script type="application/ld+json" set:html={schema}></script>}
        
        {!schema && (
         <!-- Schema.org Markup for Local Business as default -->
        <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "LocalBusiness",
              "@id": "https://koeln-fuehrerschein.de/#organization",
              "name": "Koeln-Fuehrerschein",
              "alternateName": "Köln Führerschein",
              "image": "https://koeln-fuehrerschein.de/images/og-image.webp",
              "logo": "https://koeln-fuehrerschein.de/images/logo.png",
              "description": "Ihre professionelle Führerschein-Beratungsagentur in Europa. Wir begleiten Sie durch den gesamten EU-Führerscheinprozess – von der Erstberatung bis zur Aushändigung.",
              "url": "https://koeln-fuehrerschein.de",
              "email": "contact@koeln-fuehrerschein.de",
              "address": {
                "@type": "PostalAddress",
                "streetAddress": "Domkloster 4",
                "addressLocality": "Köln",
                "postalCode": "50667",
                "addressRegion": "Nordrhein-Westfalen",
                "addressCountry": "DE"
              },
              "geo": {
                "@type": "GeoCoordinates",
                "latitude": 50.937531,
                "longitude": 6.960279
              },
              "areaServed": [
                {
                  "@type": "Country",
                  "name": "Deutschland"
                },
                {
                  "@type": "Country", 
                  "name": "Österreich"
                },
                {
                  "@type": "Country",
                  "name": "Schweiz"
                }
              ],
              "serviceType": ["EU Führerschein Beratung", "Führerschein Vermittlung", "MPU Coaching", "Bootsführerschein", "Angelschein"],
              "priceRange": "€€€",
              "openingHoursSpecification": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
                "opens": "00:00",
                "closes": "23:59"
              },
              "sameAs": [],
              "hasOfferCatalog": {
                "@type": "OfferCatalog",
                "name": "Führerschein Services",
                "itemListElement": [
                  {
                    "@type": "Offer",
                    "itemOffered": {
                      "@type": "Service",
                      "name": "EU Führerschein Beratung",
                      "description": "Professionelle Beratung und Begleitung beim EU-Führerscheinerwerb in Partnerfahrschulen"
                    }
                  },
                  {
                    "@type": "Offer",
                    "itemOffered": {
                      "@type": "Service",
                      "name": "EU Führerschein Vermittlung",
                      "description": "Vollständige Vermittlung und Begleitung für EU-Führerscheine aus Polen, Tschechien, Ungarn und Österreich"
                    }
                  },
                  {
                    "@type": "Offer",
                    "itemOffered": {
                      "@type": "Service",
                      "name": "MPU Coaching & Beratung",
                      "description": "Professionelles MPU-Coaching und Beratung zur EU-Führerschein-Alternative"
                    }
                  }
                ]
              }
            }
        </script>
        )}
        
        <!-- Website Schema -->
        <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "WebSite",
              "@id": "https://koeln-fuehrerschein.de/#website",
              "url": "https://koeln-fuehrerschein.de",
              "name": "Koeln-Fuehrerschein",
              "description": "Ihr Partner für den EU-Führerscheinerwerb in Europa – professionelle Beratung und vollständige Begleitung",
              "publisher": {
                "@id": "https://koeln-fuehrerschein.de/#organization"
              },
              "inLanguage": "de-DE",
              "potentialAction": {
                "@type": "SearchAction",
                "target": "https://koeln-fuehrerschein.de/?s={search_term_string}",
                "query-input": "required name=search_term_string"
              }
            }
        </script>
	</head>
	<body class="font-sans text-gray-800 bg-gray-50 flex flex-col min-h-screen">
        <Header />
		<slot />
        <Footer />

        <!-- Floating Contact Button -->
        <a href="/kontakt/" class="fixed bottom-6 right-6 z-50 bg-blue-600 hover:bg-blue-700 text-white p-4 shadow-2xl transition-all duration-300 hover:scale-110 flex items-center justify-center group" aria-label="Kontakt">
            <svg class="w-8 h-8 md:w-10 md:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <span class="absolute right-full mr-4 bg-white text-gray-800 px-3 py-1 shadow-lg text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Kostenlos anfragen</span>
        </a>
	</body>
</html>
